MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=tech_news

# Get a key from https://gnews.io/
NEWS_API_URL=https://gnews.io/api/v4/search
NEWS_API_KEY=
NEWS_SEARCH_QUERY=technology OR artificial intelligence OR agentic AI OR quantum computing OR cloud computing OR cybersecurity OR software OR startups
NEWS_MAX_RESULTS=10

NEWS_SCHEDULE_HOUR=6
NEWS_SCHEDULE_MINUTE=0
NEWS_TIMEZONE=UTC
